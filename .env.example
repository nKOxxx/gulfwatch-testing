# =============================================================================
# Gulf Watch - Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development                    # development | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
PORT=3000                               # API server port

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + TimescaleDB)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://gulfwatch:changeme@localhost:5432/gulfwatch?sslmode=prefer
DATABASE_SSL=true                       # Require TLS for DB connections
POSTGRES_PASSWORD=changeme              # Used by docker-compose for init

# ---------------------------------------------------------------------------
# Redis (caching, rate limiting, BullMQ)
# ---------------------------------------------------------------------------
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_PASSWORD=changeme                 # Used by docker-compose

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
JWT_SECRET=                             # Base64-encoded, >= 256 bits. Required in production.
JWT_ISSUER=https://gulfwatch.io         # JWT iss claim
JWT_AUDIENCE=gulfwatch-api              # JWT aud claim
ACCESS_TOKEN_TTL=900                    # Access token lifetime in seconds (default 15 min)
REFRESH_TOKEN_TTL=604800                # Refresh token lifetime in seconds (default 7 days)
# JWT_PRIVATE_KEY=                      # PEM-encoded PKCS#8 RSA private key (for RS256 mode)
# JWKS_URI=                             # JWKS endpoint URL (for RS256 mode)

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000  # Comma-separated list of allowed origins

# ---------------------------------------------------------------------------
# External Data Sources
# ---------------------------------------------------------------------------
OPENSKY_USERNAME=                       # OpenSky Network API username
OPENSKY_PASSWORD=                       # OpenSky Network API password
NASA_FIRMS_API_KEY=                     # NASA FIRMS fire detection API key
TWITTER_BEARER_TOKEN=                   # Twitter/X API v2 bearer token
NEWSDATA_API_KEY=                       # NewsData.io API key

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
GULFWATCH_ADMIN_KEY=                    # Admin API key for privileged operations

# ---------------------------------------------------------------------------
# Docker Compose Port Overrides
# ---------------------------------------------------------------------------
APP_PORT=3000                           # Host port for the app container
POSTGRES_PORT=5432                      # Host port for PostgreSQL
REDIS_PORT=6379                         # Host port for Redis

# ---------------------------------------------------------------------------
# Ingestion Pipeline
# ---------------------------------------------------------------------------
AIRGAP=false                            # Set true for air-gapped deployments (disables external pollers)
POLL_INTERVAL_SECONDS=300               # Polling interval for data sources (default 5 min)

# ---------------------------------------------------------------------------
# Encrypted Config (optional, for air-gap)
# ---------------------------------------------------------------------------
# CONFIG_ENCRYPTION_PASSPHRASE=         # Passphrase for decrypting .env.vault
